{
  "profiles": {
    "IntelliSenseLocalizer - show": {
      "commandName": "Project",
      "commandLineArgs": "show refs"
    },
    "IntelliSenseLocalizer - build": {
      "commandName": "Project",
      "commandLineArgs": "build -p Microsoft.NETCore.App.Ref -m net11.0 -pc 1 -ll 2 -cc 2 -sl \"-------- 以下为原始注释 --------\""
    },
    "IntelliSenseLocalizer - install": {
      "commandName": "Project",
      "commandLineArgs": "install auto -ctn true -cc 2"
    },
    "IntelliSenseLocalizer - uninstall": {
      "commandName": "Project",
      "commandLineArgs": "uninstall net11.0 zh-cn"
    },
    "IntelliSenseLocalizer - clear": {
      "commandName": "Project",
      "commandLineArgs": "clear build"
    },
    "IntelliSenseLocalizer - clean": {
      "commandName": "Project",
      "commandLineArgs": "clean"
    },
    "IntelliSenseLocalizer - translate": {
      "commandName": "Project",
      "commandLineArgs": "translate -f \"{xml_file_path}\" -s http://127.0.0.1:16432 -p false"
    }
  }
}
